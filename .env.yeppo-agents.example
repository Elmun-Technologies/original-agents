# Yeppo marketing agents (yeppo_agents/). Copy values into Coolify; never commit real values.
YEPPO_API_URL=https://yeppo.uz          # site (Payload) the agent reads/writes
YEPPO_SITE_URL=https://yeppo.uz         # links in captions (UTM-tagged)
YEPPO_API_EMAIL=                        # a site admin user created for the agent
YEPPO_API_PASSWORD=
ANTHROPIC_API_KEY=
YEPPO_LLM_MODEL=                        # optional; default in config/yeppo.yaml
TELEGRAM_BOT_TOKEN=                     # @Originalpobot (Poizon bot must stay paused) or a new Yeppo bot
TELEGRAM_ADMIN_IDS=                     # comma-separated Telegram user ids
SCRAPER_CONTACT_EMAIL=                  # shown in the User-Agent to source sites
DRY_RUN=true                            # true: "Katalogga qo'shish" does not write to the site
# YEPPO_AGENTS_DB_URL=                  # optional Postgres; default SQLite in the data volume
