# Copy to .env and fill in. Never commit .env.
# Run locally with: uv run --env-file .env ...
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
TELEGRAM_BOT_TOKEN=
# comma-separated numeric ids
TELEGRAM_ADMIN_IDS=
TELEGRAM_CHANNEL_ID=
DATABASE_URL=sqlite:///data/app.db
CHATPLACE_API_TOKEN=
# goes into User-Agent for poizon.com requests
SCRAPER_CONTACT_EMAIL=
# true: nothing is published, messages go to admin only
DRY_RUN=true
