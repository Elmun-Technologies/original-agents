# Copy to .env and fill in. Never commit .env.
# Run locally with: uv run --env-file .env ...
ANTHROPIC_API_KEY=
# Claude model id for all agents, e.g. claude-opus-5-5 (must have a price in settings.yaml llm.prices_per_mtok)
LLM_MODEL=claude-opus-5-5
TELEGRAM_BOT_TOKEN=
# comma-separated numeric ids
TELEGRAM_ADMIN_IDS=
TELEGRAM_CHANNEL_ID=
DATABASE_URL=sqlite:///data/app.db
CHATPLACE_API_TOKEN=
# optional, goes into the User-Agent of image downloads (source_images)
SCRAPER_CONTACT_EMAIL=
# true: nothing is published, messages go to admin only
DRY_RUN=true
