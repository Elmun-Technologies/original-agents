# --- Database / admin ---
DATABASE_URI=postgres://yeppo:yeppo@localhost:5434/yeppo
PAYLOAD_SECRET=change-me-long-random

# --- Site address: the ONE place for the domain (no trailing slash) ---
NEXT_PUBLIC_SITE_URL=https://yeppo.uz

# --- Payments ---
# mock = test mode (no money, test page instead of Click/Payme); live = real payments
PAYMENTS_MODE=mock
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=
# 1 while testing in Payme's sandbox (checkout.test.paycom.uz)
PAYME_TEST=
# Uzcard/Humo option goes through: payme | click
CARD_PROVIDER=payme

# --- Telegram (admin notifications about paid orders) ---
TELEGRAM_BOT_TOKEN=
# comma-separated Telegram user ids of the admins
TELEGRAM_ADMIN_IDS=
