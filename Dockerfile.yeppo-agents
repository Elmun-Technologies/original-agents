# Yeppo marketing agents (yeppo_agents/): Telegram bot + scheduler. Needs ffmpeg for Reels.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    TZ=Asia/Tashkent \
    PATH=/app/.venv/bin:$PATH \
    YEPPO_DATA_DIR=/app/data/yeppo

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg tzdata && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /usr/local/bin/uv
WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY app/__init__.py app/config.py app/
COPY app/scraping app/scraping
COPY config config
COPY prompts prompts
COPY yeppo_agents yeppo_agents
RUN uv sync --frozen --no-dev

CMD ["python", "-m", "yeppo_agents.bot"]
